# Development environment for SimEng
FROM ubuntu:20.04

# Install build dependencies
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
      build-essential \
      cmake \
      git \
      llvm-9-dev \
      ninja-build \
      zlib1g-dev \
      python3 \
      python3-dev \
      wget \
      libtool \
      autoconf \
      automake \
      && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Build SST 12.0.1
COPY sstcore-12.0.1.tar.gz /tmp/
COPY sstelements-12.0.1.tar.gz /tmp/

RUN cd /tmp && \
    tar -xzf sstcore-12.0.1.tar.gz && \
    cd sstcore-12.0.1 && \
    ./configure --prefix=/usr/local/sst --disable-mpi && \
    make -j$(nproc) && \
    make install && \
    cd .. && \
    rm -rf sstcore-12.0.1*

RUN cd /tmp && \
    tar -xzf sstelements-12.0.1.tar.gz && \
    cd sst-elements-library-12.0.1 && \
    ./configure --prefix=/usr/local/sst --with-sst-core=/usr/local/sst --disable-mpi && \
    make -j$(nproc) && \
    make install && \
    cd .. && \
    rm -rf sst-elements-library-12.0.1*

# Set environment variables for SST
ENV PATH="/usr/local/sst/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/sst/lib:${LD_LIBRARY_PATH}"

# Set working directory
WORKDIR /workspace/SimEng

# Default command
CMD ["/bin/bash"]
